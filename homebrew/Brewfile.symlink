cask 'moom'
cask 'obsidian'
cask 'ollama'
cask 'orbstack'
cask 'plex'
cask 'plexamp'
cask 'raycast'
cask 'slack'
cask 'soundsource'
cask 'visual-studio-code'
cask 'vlc'
cask 'wireshark-app'

