# Main Brewfile used on all machines

brew 'ack'
brew 'bash'
brew 'bash-completion@2'
brew 'btop'
brew 'cmake'
brew 'curl'
brew 'difftastic'
brew 'fd'
brew 'ffmpeg'
brew 'fzf'
brew 'git'
brew 'jq'
brew 'libyaml'  # needed for ruby-build and mise/asdf
brew 'mas'
brew 'mise'
brew 'mtr'
brew 'nmap'
brew 'pstree'
brew 'rsync'
brew 'shellcheck'
brew 'starship'
brew 'the_silver_searcher'
brew 'tree'
brew 'wget'
brew 'yt-dlp'

