#!/usr/bin/env bash
#/ Usage: cpa <command> [options]
#/
#/   This helper script simplifies running the `cliproxyapi` command line
#/   tool with custom configuration files. This script assumes that
#/   `cliproxyapi` is installed and managed via Homebrew, and that the
#/   services is run via `brew` commands.
#/
#/   This script looks for configuration files and service `.plist` files
#/   in the following directory path:
#/
#/     ~/.config/cliproxyapi/
#/
#/   There should be a `conf.yaml` file and a `service.plist` file.
#/
#/   COMMANDS:
#/     start              Start `cliproxyapi` as a service
#/     stop               Stop the `cliproxyapi` service
#/     restart            Restart the `cliproxyapi` service
#/     login              Login to your claude.ai account
#/     get                Get credentials from 1Password
#/     store              Store credentials in 1Password
#/     expires            Show when the credentials expire
#/     reset              Remove local claude.ai credentials
#/
#/   OPTIONS
#/     -f, --force        Renew credentials even when not expired
#/     -h, --help         Show this help message
#/     -v, --verbose      Print script debug info
#/
#/   EXAMPLE:
#/     cap login
#/     cpa -v start
#/     cpa restart
#/     cpa login -f
#/     cpa --help
#/     cpa
#/
#——————————————————————————————————————————————————————————————————————————————
set -o errexit
set -o nounset
if [ "${TRACE:-0}" -eq "1" ]; then
  set -o xtrace
fi

cpa_cfg="$CPA_HOME/config.yaml"
cpa_claude_cred="${CPA_CL_CRED:-}"
cpa_codex_cred="${CPA_CO_CRED:-}"
cpa_op_acct="${CPA_OP_ACCT:-}"
cpa_op_vault="${CPA_OP_VAULT:-}"

usage() {
  grep "^#/" "$0" | cut -c 4-
}

parse_params() {
  command=''
  force=0

  while :; do
    case "${1:-}" in
    -h | --help ) usage && exit ;;
    -v | --verbose ) set -o xtrace ;;
    -f | --force ) force=1 ;;
    login | expires | reset | store | get ) command="cpa_$1" ;;
    start | stop | restart ) command="cpa_$1" ;;
    *) break ;;
    esac
    shift
  done

  args=("$@")
}

cpa_login() {
  cpa_claude_login
  cpa_codex_login
}

cpa_expires() {
  # Claude
  if [ -n "${cpa_claude_cred}" ]; then
    echo "Claude: $(jq -r '.expired' "$cpa_claude_cred")"
  fi

  # Codex
  if [ -n "${cpa_codex_cred}" ]; then
    echo " Codex: $(jq -r '.expired' "$cpa_codex_cred")"
  fi
}

cpa_reset() {
  # Claude
  if [ -n "${cpa_claude_cred}" ]; then
    echo "Removing claude.ai authentication credentials"
    echo "---- ${cpa_claude_cred}"
    rm "${cpa_claude_cred}"
  fi

  # Codex
  if [ -n "${cpa_codex_cred}" ]; then
    echo "Removing chatgpt.com authentication credentials"
    echo "---- ${cpa_codex_cred}"
    rm "${cpa_codex_cred}"
  fi
}

cpa_get() {
  if [ -n "${cpa_claude_cred}" ]; then
    cpa_get_token "$cpa_claude_cred" "Claude OAuth"
  fi
  if [ -n "${cpa_codex_cred}" ]; then
    cpa_get_token "$cpa_codex_cred" "Codex OAuth"
  fi
}

cpa_store() {
  if [ -n "${cpa_claude_cred}" ]; then
    cpa_store_token "$cpa_claude_cred" "Claude OAuth"
  fi
  if [ -n "${cpa_codex_cred}" ]; then
    cpa_store_token "$cpa_codex_cred" "Codex OAuth"
  fi
}

cpa_get_token() {
  local cred_file="$1"
  local op_doc="$2"

  if [ -z "${cpa_op_acct}" ]; then exit 0; fi
  if op --account "${cpa_op_acct}" --vault "${cpa_op_vault}" document list | grep "$op_doc" > /dev/null 2>&1; then
    echo "Loading document from 1Passowrd: '$op_doc'"
    op --account "${cpa_op_acct}" --vault "${cpa_op_vault}" \
      document get "$op_doc" --out-file "$cred_file" --file-mode 0644 --force
  else
    echo "Document not found in 1Passowrd: '$op_doc'"
  fi
}

cpa_store_token() {
  local cred_file="$1"
  local op_doc="$2"

  if [ -z "${cpa_op_acct}" ]; then exit 0; fi
  if op --account "${cpa_op_acct}" --vault "${cpa_op_vault}" document list | grep "$op_doc" > /dev/null 2>&1; then
    echo "Updating document in 1Passowrd: '$op_doc'"
    op --account "${cpa_op_acct}" --vault "${cpa_op_vault}" \
      document edit "$op_doc" "$cred_file"
  else
    echo "Creating document in 1Passowrd: '$op_doc'"
    op --account "${cpa_op_acct}" --vault "${cpa_op_vault}" \
      document create --title "$op_doc" "$cred_file" > /dev/null
  fi
}

#—— cliproxyapi ———————————————————————————————————————————————————————————————

cpa_start() {
  brew services start cliproxyapi --file "$CPA_HOME/service.plist"
}

cpa_stop() {
  brew services stop cliproxyapi
}

cpa_restart() {
  brew services restart cliproxyapi --file "$CPA_HOME/service.plist"
}

#—— Claude ————————————————————————————————————————————————————————————————————

cpa_claude_login() {
  if [ -z "${cpa_claude_cred}" ]; then
    return
  fi

  local now expired
  now=$(date '+%s')
  expired=0
  if [ -f "$cpa_claude_cred" ]; then
    expired="$(jq -r '.expired' "$cpa_claude_cred" | sed 's/:\([^:]*\)$/\1/')"
    expired=$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "${expired}" '+%s')
  fi

  if [[ $force -eq 1 || $now -ge $expired ]]; then
    echo "Renewing Claude OAuth token"
    cliproxyapi --claude-login --config "$cpa_cfg"
    cpa_store_token "$cpa_claude_cred" "Claude OAuth"
  else
    echo "Claude OAuth token is valid"
  fi
}

#—— Codex —————————————————————————————————————————————————————————————————————

cpa_codex_login() {
  if [ -z "${cpa_codex_cred}" ]; then
    return
  fi

  local now expired
  now=$(date '+%s')
  expired=0
  if [ -f "$cpa_codex_cred" ]; then
    expired="$(jq -r '.expired' "$cpa_codex_cred" | sed 's/:\([^:]*\)$/\1/')"
    expired=$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "${expired}" '+%s')
  fi

  if [[ $force -eq 1 || $now -ge $expired ]]; then
    echo "Renewing Codex OAuth token"
    cliproxyapi --codex-login --config "$cpa_cfg"
    cpa_store_token "$cpa_codex_cred" "Codex OAuth"
  else
    echo "Codex OAuth token is valid"
  fi
}

#—— main ——————————————————————————————————————————————————————————————————————

parse_params "$@"

if [ -n "${command}" ]; then
  ${command} "${args[@]}"
else
  usage
fi
