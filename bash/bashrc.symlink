# ~/.bashrc
# Executed by login and subshells

# confiure starship prompt
if [ -f "$HOMEBREW_ROOT/bin/starship" ]; then
  eval "$(starship init bash)"
fi

# confiure direnv tool
if [ -f "$HOMEBREW_ROOT/bin/direnv" ]; then
  eval "$(direnv hook bash)"
fi

if [[ -a $HOME/.localrc ]] ; then source $HOME/.localrc ; fi

# vim:ft=sh
